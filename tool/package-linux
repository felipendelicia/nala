#!/usr/bin/env bash
set -euo pipefail

if (( $# != 2 )); then
  echo 'Uso: tool/package-linux BUNDLE Nala-Linux-x64.tar.gz' >&2
  exit 2
fi

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
bundle="$(realpath -e -- "$1")"
output_dir="$(realpath -e -- "$(dirname -- "$2")")"
output="$output_dir/$(basename -- "$2")"

if [[ ! -x "$bundle/apuntes" || ! -f "$bundle/data/flutter_assets/version.json" ]]; then
  echo 'Elegí el bundle generado por la compilación Linux de Nala.' >&2
  exit 1
fi
if [[ -n "$(find "$bundle" ! -type f ! -type d -print -quit)" ]]; then
  echo 'El bundle sólo puede contener archivos y carpetas.' >&2
  exit 1
fi

work="$(mktemp -d -- "$output_dir/.nala-package.XXXXXXXX")"
trap 'rm -rf -- "$work"' EXIT
cp -a -- "$bundle" "$work/Nala-Linux"
install -m 755 -- "$repo_root/tool/linux/Abrir-Nala.sh" "$work/Abrir-Nala.sh"
install -m 644 -- "$repo_root/assets/nala-icon.png" "$work/Nala-Linux/nala-icon.png"
tar --format=ustar --hard-dereference -czf "$work/paquete.tar.gz" \
  -C "$work" Abrir-Nala.sh Nala-Linux
mv -fT -- "$work/paquete.tar.gz" "$output"
printf '%s\n' "$output"
